APP_PORT=3000
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://your-domain.com
# Exact frontend origins, comma-separated. No wildcard; leave unset for local defaults.
CORS_ALLOWED_ORIGINS=https://posttalk.vercel.app

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Media: Supabase Pro private Storage. Billing is configured in the dashboard.
MEDIA_STORAGE_PROVIDER=supabase
# Read-only report warning threshold, decimal GB. Not an org-wide quota or hard cap.
MEDIA_STORAGE_WARNING_GB=70

# OpenAI / AI pipeline
OPENAI_API_KEY=
QUOTE_VIDEO_API_URL=
QUOTE_VIDEO_API_KEY=
QUOTE_VIDEO_BGM_URL=
QUOTE_VIDEO_TIMEOUT_SECONDS=120
DATA_GO_KR_SERVICE_KEY=
TOUR_API_SERVICE_KEY=
FESTIVAL_LOOKAHEAD_DAYS=7
FESTIVAL_MAX_DISTANCE_KM=5
WEATHER_API_BASE_URL=https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0
WEATHER_API_SERVICE_KEY=
WEATHER_API_RESPONSE_FORMAT=JSON
KAMIS_API_SERVICE_KEY=
KAMIS_LOOKBACK_DAYS=7
TOURISM_CORPUS_REPORT_PATH=
TOURISM_CORPUS_MAX_ITEMS=3

# Social publishing
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_IG_USER_ID=
INSTAGRAM_GRAPH_API_VERSION=v24.0

# QR entry
# Supports placeholders: {qrToken}, {slotKey}, {storeId}, {slotNumber}
QR_ENTRY_REDIRECT_URL_TEMPLATE=

# Server-to-server worker authentication (never expose to a frontend)
INTERNAL_WORKER_API_KEY=
# Set false when validating a new deployment to avoid recovering existing paid jobs.
GENERATION_WORKER_ENABLED=false

# Exhibition-only API. user_id=1 is a shared demo identity, not production authentication.
EXHIBITION_MODE_ENABLED=false
EXHIBITION_STORE_ID=
# Random value of at least 32 characters; keep stable while the exhibition is running.
EXHIBITION_PUBLISH_SECRET=
EXHIBITION_SCRIPT_MODEL=gpt-4.1-mini
