# Copy to .env.staging locally after creating a separate test project.
# Never replace the existing .env or commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_NEW_TEST_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_TEST_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_TEST_SERVICE_ROLE_OR_SECRET_KEY
MEDIA_STORAGE_PROVIDER=supabase
MEDIA_STORAGE_WARNING_GB=70
NEXT_PUBLIC_APP_URL=http://localhost:3100
PUBLIC_APP_URL=http://localhost:3100
EXHIBITION_MODE_ENABLED=false
EXHIBITION_STORE_ID=
EXHIBITION_PUBLISH_SECRET=
# Supply a new random worker key for staging; do not reuse the original project's key.
INTERNAL_WORKER_API_KEY=
# Explicit blanks prevent Next.js from inheriting these from the existing .env.
# Enable a supplier separately only when its real integration test is intended.
OPENAI_API_KEY=
GEMINI_API_KEY=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_IG_USER_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
QUOTE_VIDEO_API_URL=
QUOTE_VIDEO_API_KEY=
QUOTE_VIDEO_BGM_URL=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
