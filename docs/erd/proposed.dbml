// REVIEW DRAFT: target model, NOT the deployed schema or an executable migration.
// Final concept definitions and account-to-store authorization remain undecided.
Project postalk_proposed {
  database_type: 'PostgreSQL'
  Note: 'Review draft. No administrator workflow. Merchant explicitly publishes. Frontend Context remains temporary: sessions group backend work and do not imply automatic refresh restoration. Public demo user_id=1 is not a real account.'
}

Table stores {
  id uuid [pk, not null]
  market_name text [not null]
  store_name text [not null]
  location_address text
  description text
  created_at timestamptz [not null]
  indexes { (market_name, store_name) [unique] }
}

Table input_templates {
  id uuid [pk, not null]
  store_id uuid [not null]
  name text [not null]
  store_description text [not null]
  menus jsonb [not null, note: '1..3 menu snapshots with stable local keys, names and descriptions.']
  created_at timestamptz [not null]
  Note: 'Saved input form, NOT a visual concept. Loading copies values; later edits do not modify historical sessions.'
}

Table concept_versions {
  id uuid [pk, not null]
  concept_key text [not null]
  version text [not null]
  format text [not null, note: 'card_news | reels']
  renderer_key text [not null]
  uses_subtitles boolean [not null]
  max_subtitle_chars integer
  scene_definition jsonb [not null, note: 'Ordered required shots, allowed image/video kinds, duration limits. Final definitions supplied by concept teammate.']
  created_at timestamptz [not null]
  indexes { (concept_key, version) [unique] }
  Note: 'Immutable once used. New design or renderer contract requires a new version. Do not invent three final concepts.'
}

Table creation_sessions {
  id uuid [pk, not null, note: 'Same client creationId used for uploads, scripts and generation.']
  store_id uuid [not null]
  concept_version_id uuid [not null]
  input_snapshot jsonb [not null]
  input_digest text
  status text [not null, note: 'collecting | submitted | abandoned']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes { (id, store_id) [unique] }
  Note: 'Created lazily when the first backend operation needs it. Define snapshot revision rules for changed inputs and script requests. Camera Blobs stay in frontend memory until generation upload. Final input freezes atomically at submission. Session id alone never grants publish permission.'
}

Table creation_scenes {
  id uuid [pk, not null]
  session_id uuid [not null]
  store_id uuid [not null]
  scene_number integer [not null]
  menu_key text
  media_type text [not null, note: 'image | video']
  subtitle text [note: 'Final edited text; exactly the same input is sent to TTS.']
  duration_seconds "double precision"
  indexes {
    (session_id, scene_number) [unique]
    (id, session_id, store_id) [unique]
  }
  Note: 'Scene count/order/media and menu keys must match the immutable concept plus input snapshot. Validate in the submission transaction. No subtitles/TTS on silent templates; no BGM or source audio in rendered reels.'
}

Table media_assets {
  id uuid [pk, not null]
  store_id uuid [not null]
  provider text [not null, note: 'supabase | s3']
  bucket text [not null]
  object_key text [not null]
  mime_type text [not null]
  file_size bigint [not null]
  duration_seconds "double precision"
  checksum_sha256 text
  created_at timestamptz [not null]
  indexes {
    (provider, bucket, object_key) [unique]
    (id, store_id) [unique]
  }
  Note: 'No binary files or expiring signed URLs in DB. Migration updates a verified storage locator while asset id remains stable. Retention/orphan cleanup is a separate job; soft deletion must not immediately erase media.'
}

Table scene_media {
  scene_id uuid [not null]
  session_id uuid [not null]
  store_id uuid [not null]
  media_asset_id uuid [not null]
  indexes {
    (scene_id) [pk]
    (scene_id, session_id, store_id) [unique]
  }
  Note: 'One selected source per scene. Composite FKs prevent cross-session scene links and cross-store media links. Before generation, an upload retry replaces this selection; storage cleanup is delayed.'
}

Table script_jobs {
  id uuid [pk, not null]
  session_id uuid [not null]
  store_id uuid [not null]
  input_digest text [not null]
  input_snapshot jsonb [not null]
  status text [not null, note: 'queued | processing | completed | failed']
  result jsonb
  failure_reason text
  lease_owner uuid
  lease_expires_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes { (session_id, input_digest) [unique] }
  Note: 'Asynchronous subtitle suggestions before rendering. Changed input has a new digest; failed requests can reuse the same job. Frontend must ignore stale results for older inputs.'
}

Table contents {
  id uuid [pk, not null]
  session_id uuid [not null, unique]
  store_id uuid [not null]
  caption text
  deleted_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes {
    (id, store_id) [unique]
    (session_id, store_id) [unique]
  }
  Note: 'Created with the initial generation job in one transaction. session_id uniqueness makes generation POST idempotent. Format and concept derive from the frozen session. Caption <=2200 Unicode code points and <=30 hashtags. Caption editing locks during publishing and after published. Delete means archive hiding, not Instagram deletion.'
}

Table generation_jobs {
  id uuid [pk, not null]
  content_id uuid [not null]
  store_id uuid [not null]
  status text [not null, note: 'queued | processing | completed | failed']
  stage text
  request_snapshot jsonb [not null]
  result jsonb
  progress jsonb [not null]
  failure_reason text
  lease_owner uuid
  lease_expires_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes { (id, content_id, store_id) [unique] }
  Note: 'Required SQL partial unique index: content_id WHERE status IN (queued,processing). Atomic lease claim/renewal, guarded retries and worker recovery must be retained. Reuse failed job for the existing retry API unless an explicit attempt-history contract is approved.'
}

Table content_outputs {
  id uuid [pk, not null]
  content_id uuid [not null]
  store_id uuid [not null]
  generation_job_id uuid [not null]
  media_asset_id uuid [not null]
  purpose text [not null, note: 'card_image | reel_video | thumbnail | narration']
  sort_order integer [not null]
  indexes { (generation_job_id, purpose, sort_order) [unique] }
  Note: 'Only expose outputs of the selected successful generation. Composite FKs enforce job/content/store and media/store ownership. Publish only complete expected card sets or a complete reel; narration is not an Instagram carousel item.'
}

Table publication_attempts {
  id uuid [pk, not null]
  content_id uuid [not null]
  store_id uuid [not null]
  platform text [not null, note: 'instagram initially']
  attempt_number integer [not null]
  status text [not null, note: 'queued | publishing | published | failed | unknown']
  caption_snapshot text [not null]
  media_snapshot jsonb [not null]
  external_container_id text
  external_post_id text
  permalink text
  failure_reason text
  lease_owner uuid
  lease_expires_at timestamptz
  published_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes { (content_id, platform, attempt_number) [unique] }
  Note: 'Explicit merchant action with creation capability required. No auto-post after generation. Lock the content row when starting a publish, caption edit or delete. Required SQL partial unique index on (content_id,platform) WHERE status IN (queued,publishing,published,unknown); failed attempts retained, unknown requires reconciliation before retry. Derive UI unpublished/publishing/published/failed from attempts, not a second writable status. Persist container ids promptly and do not blindly repeat uncertain external calls.'
}

Ref: input_templates.store_id > stores.id
Ref: creation_sessions.store_id > stores.id
Ref: creation_sessions.concept_version_id > concept_versions.id
Ref: creation_scenes.(session_id, store_id) > creation_sessions.(id, store_id)
Ref: media_assets.store_id > stores.id
Ref: creation_scenes.(id, session_id, store_id) - scene_media.(scene_id, session_id, store_id)
Ref: scene_media.(media_asset_id, store_id) > media_assets.(id, store_id)
Ref: script_jobs.(session_id, store_id) > creation_sessions.(id, store_id)
Ref: creation_sessions.(id, store_id) - contents.(session_id, store_id)
Ref: generation_jobs.(content_id, store_id) > contents.(id, store_id)
Ref: content_outputs.(generation_job_id, content_id, store_id) > generation_jobs.(id, content_id, store_id)
Ref: content_outputs.(media_asset_id, store_id) > media_assets.(id, store_id)
Ref: publication_attempts.(content_id, store_id) > contents.(id, store_id)
